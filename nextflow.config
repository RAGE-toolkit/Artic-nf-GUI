// nextflow.config

params {
    // general settings
    output_dir      = 'results'
    out_dir         = 'results'
    meta_file       = null
    sample_sheet    = params.sample_sheet ?: params.meta_file
    basecaller      = 'Dorado'
    rawfile_type    = 'fastq'
    rawfile_dir     = null
    fastq_dir       = 'raw_files/fastq'
    primer_schema   = "${projectDir}/meta_data/primer-schemes"
    kit_name        = 'EXP-NBD196'
    fq_extension    = '.fastq'
    script          = 'scripts'
    threads         = 5
    run_name        = null

    // dorado settings
    // Leave these unset by default so GUI/CLI installs do not break when
    // a concrete local tool path is not available in the current environment.
    dorado_dir      = null
    dorado_model_path = null
    dorado_config   = 'dna_r9.4.1_e8_fast@v3.4'
    dorado_run_mode = 'cuda:0'

    // guppy settings
    guppy_dir       = null
    guppy_config    = 'dna_r9.4.1_450bps_fast.cfg'
    guppy_cpu_threads = 4
    guppy_run_mode  = 'cuda:all'

    seq_len         = 350
    seq_max_len     = 700

    mask_depth      = 20
    normalise       = 100
    primer_match_threshold = 35
    min_mapq        = 20
    min_variant_quality = 10
    min_allele_frequency = 0.6
    min_mask_allele_frequency = 0.1
    min_frameshift_quality = 50
    min_minor_allele_count = 4

    // clair3 settings
    model_path      = '/opt/miniforge/envs/clair3env/bin/models/r1041_e82_400bps_hac_v520'

    // GUI compatibility
    basecaller_dir  = null
    model_dir       = null
    basecaller_config = 'dna_r10.4.1_e8.2_400bps_fast@v4.2.0'
    run_mode        = 'cuda:all'
    basecaller_threads = 5
    medaka_model    = 'r941_min_fast_g303'
    medaka_normalise = 200
}

conda.enabled = true
docker.enabled = true
docker.temp = 'auto'

executor {
  name = 'local'
  queueSize = 2
}


def detectHostArch() {
    try {
        def process = ['sysctl', '-n', 'hw.optional.arm64'].execute()
        process.waitFor()
        if (process.exitValue() == 0) {
            def output = process.text.trim()
            if (output == '1') return 'arm64'
            if (output == '0') return 'x86_64'
        }
    } catch (Exception e) {
        // key doesn't exist (not macOS) - fall through
    }
    // Non-macOS (e.g. Linux): no Rosetta-style inheritance to worry about,
    // so a plain uname -m is reliable here.
    try {
        def process = ['uname', '-m'].execute()
        process.waitFor()
        def output = process.text.trim().toLowerCase()
        if (output) return output
    } catch (Exception e) {
        // fall through to the JVM-reported value below
    }
    return System.getProperty('os.arch').toLowerCase()
}

def arch_type = detectHostArch()

def docker_image_type() {
    def architecture = detectHostArch()
    if (architecture == 'aarch64' || architecture == 'arm64') {
        return 'rage2025/artic-nf-arm64:v2.0'
    }
    else if (architecture == 'amd64' || architecture == 'x86_64') {
        return 'rage2025/artic-nf-amd64:v2.0'
    }
    else {
        throw new RuntimeException("Unsupported architecture: " + architecture)
    }
}

params.arch_type = arch_type
def container_name = docker_image_type()

profiles {
    standard {
        process.container = container_name
    }

    docker {
        process {
            withName: PLEX_FQ_FILES { container = container_name }
            withName: PLEX_DIRS { container = container_name }
            withName: MINIMAP2 { container = container_name }
            withName: ALIGN_TRIM { container = container_name }
            withName: SPLIT_UNMATCHED { container = container_name }
            withName: CLAIR3 { container = container_name }
            withName: CLAIR3_2 { container = container_name }
            withName: CLAIR3_UNMATCHED { container = container_name }
            withName: VCF_MERGE { container = container_name }
            withName: VCF_FILTER { container = container_name }
            withName: COMPRESS_AND_INDEX_VCF { container = container_name }
            withName: MAKE_DEPTH_MASK { container = container_name }
            withName: MASK { container = container_name }
            withName: BCFTOOLS_NORM { container = container_name }
            withName: BCFTOOLS_CONSENSUS { container = container_name }
            withName: FASTA_HEADER { container = container_name }
            withName: CONCAT { container = container_name }
            withName: MAFFT { container = container_name }
            withName: SUMMARY_STATS { container = container_name }
            withName: REPORT { container = container_name }
        }
    }
}

manifest {
    name = 'RAGE-toolkit/Artic-nf-GUI'
    author = 'RAGE-toolkit'
    homePage = 'https://github.com/RAGE-toolkit/Artic-nf-GUI'
    description = 'Basecalling and consensus sequence generation with Clair3'
    mainScript = 'main.nf'
    nextflowVersion = '23.10.0'
    version = 'v2.0.0'
}
